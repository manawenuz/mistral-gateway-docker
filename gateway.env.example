# Copy to gateway.env (same directory as docker-compose.yml). Never commit it.
#
# VIBE_KEY: your Mistral Vibe plan key. Get it one of two ways:
#   1. Install the official CLI, log in, and copy the key:
#        curl -LsSf https://mistral.ai/vibe/install.sh | bash
#        vibe --setup            # choose browser login
#        grep MISTRAL_API_KEY ~/.vibe/.env
#   2. Or open https://chat.mistral.ai/code/extensions -> Vibe CLI card ->
#      Advanced -> copy the "Vibe API Key".
#
# GATEWAY_KEY: the key YOUR clients must send as
#   "Authorization: Bearer <key>". Required here: inside docker the gateway
#   is not on loopback, and it refuses non-loopback callers without one.
#   Generate one with:  openssl rand -hex 32

VIBE_KEY=paste-your-vibe-key-here
GATEWAY_KEY=paste-a-long-random-string-here

# Optional: pay-as-you-go fallback key from Mistral AI Studio.
# Serves requests only while the Vibe key is rate-limited or out of budget.
# STUDIO_API_KEY=

BIND=0.0.0.0
PORT=8788
LOG_LEVEL=INFO
